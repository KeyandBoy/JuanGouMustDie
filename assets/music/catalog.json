  "about": "《卷狗必须死》背景音乐曲库。本文件是唯一真相源：AudioManager 按 slots + level_scope 选曲，tools/music_catalog.py 由此导出 CATALOG.md。新增/替换曲子只改这里。",
  "legend": {
    "status": "active=正在使用 / standby=已入库但未接入 / missing=待补缺口",
    "slots": "AudioManager 内部槽位名，代码按状态机选定槽位，再由曲库解析成文件",
    "states": "语义状态：menu 主菜单 / explore_calm 平时探索 / explore_alert 警觉 / chase 被追 / quiz 答题 / tyrant 暴君 / cutscene 过场 / cleared 通关结算 / gameover 失败",
    "layer_role": "base 底曲 / rhythm 节奏层 / pressure 压迫层 / ambience 环境层 / accent 点缀层",
    "intensity": "1=最轻 5=最炸，用于检索和缺口匹配",
    "level_scope": "all=全楼层；也可以写 [1,2,3,4] 或 [5]",
    "loop": "true=循环铺底；false=一次性播放（过场/胜利/失败短句）",
    "duration_sec": "实际时长（秒），null=未测",
    "license": "commercial_ok=可商用 / attribution_required=必须署名 / modified=做过转码或电平调整（CC BY 要求注明）"
  },
